# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/

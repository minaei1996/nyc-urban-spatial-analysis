# ==========================================
# Raw source data
# ==========================================
# Keep README.md, exclude all downloaded source datasets.
data/raw/*
!data/raw/README.md

# ==========================================
# Processed data
# ==========================================
# Keep README.md, exclude standalone generated datasets.
data/processed/*
!data/processed/README.md

